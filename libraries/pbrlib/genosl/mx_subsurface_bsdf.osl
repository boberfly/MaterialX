void mx_subsurface_bsdf(float weight, color albedo, vector radius, float anisotropy, normal N, output BSDF bsdf)
{
#if OSL_VERSION_MAJOR >= 1 && OSL_VERSION_MINOR >= 14
    bsdf = subsurface_bssrdf(N, weight * albedo, color(radius), anisotropy);
#else
    bsdf = subsurface_bssrdf(N, weight * albedo, 1.0, color(radius), anisotropy);
#endif
}
